# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_MASTER_KEY=
PORT=8787

# Frontend origin allowed by CORS (defaults to * for local dev).
WEB_ORIGIN=http://localhost:5173

# Durable storage. Omit to use the in-memory store.
# DATABASE_URL=postgres://user:pass@localhost:5432/creditdocket
# PGSSL=require

# Production provider (AggregatorProvider) — fill from your credentialed account:
# AGG_BASE_URL=
# AGG_TOKEN_URL=
# AGG_CLIENT_ID=
# AGG_CLIENT_SECRET=
# AGG_SUBSCRIBER_CODE=
